{
  "name": "habithero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/verify-supabase-env.mjs local && node scripts/dev-port.mjs",
    "build": "node scripts/verify-supabase-env.mjs production && vite build --mode production",
    "build:local": "node scripts/verify-supabase-env.mjs local && vite build --mode development",
    "build:production": "npm run build",
    "cap:sync": "npm run cap:sync:production",
    "cap:sync:production": "npm run build:production && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "test": "tsx --test tests/*.test.ts",
    "test:unity-platform": "node scripts/verify-unity-platform.mjs",
    "test:unity-editmode": "node scripts/run-unity-editmode-tests.mjs",
    "build:unity-webgl": "node scripts/build-unity-webgl.mjs",
    "build:unity:ios": "node scripts/build-unity-native.mjs ios",
    "build:unity:android": "node scripts/build-unity-native.mjs android",
    "test:unity-release": "node scripts/verify-unity-release.mjs",
    "security:check": "node scripts/security-check.mjs",
    "quality:structure": "node scripts/check-source-size.mjs && node scripts/check-import-boundaries.mjs",
    "docs:mindmap": "npx --yes markmap-cli@0.18.12 --no-open --offline docs/strategy/01-product-mindmap.md -o docs/strategy/rendered/product-mindmap.html",
    "verify": "npm run lint && npm run quality:structure && npm test && npm run cap:sync && npm run security:check && git diff --check",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:reset": "npx supabase db reset",
    "supabase:migrations": "npx supabase migration list --local"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@google/genai": "^2.4.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.181.1",
    "three-mesh-bvh": "^0.9.14",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
